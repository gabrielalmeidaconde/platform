# Copie para .env (o scripts/build.sh faz isso e gera o JWT_SECRET_KEY sozinho).
# NUNCA faça commit do .env.

# Segredo do JWT (HMAC-SHA256, base64 de 32 bytes): openssl rand -base64 32
JWT_SECRET_KEY=

# 24 h, como no contrato da API
JWT_DURATION=86400000

DB_USER=store
DB_PASSWORD=store
DB_NAME=store

GATEWAY_REPLICAS=2
LB_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080

# cache do token no Redis (true/false) - útil para comparar no teste de carga
TOKEN_CACHE_ENABLED=true

# exchange: segundos que uma cotação fica em cache (0 desliga) e réplicas
EXCHANGE_CACHE_TTL=30
EXCHANGE_REPLICAS=1
# token da AwesomeAPI (opcional; sem ele vale o limite gratuito)
EXCHANGE_API_TOKEN=

# observabilidade (só em 127.0.0.1): http://localhost:3000 (admin / senha abaixo)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# mensageria (Kafka + Mailpit, só em 127.0.0.1): Kafka UI e caixa de e-mail
KAFKA_UI_PORT=8089
MAILPIT_PORT=8025
NOTIFY_CONCURRENCY=3
EMAIL_LATENCY=50ms
NOTIFY_IDEMPOTENT=true
